{
  "name": "bot-arena",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p engine && tsc -p sandbox && tsc -p server && tsc -p cli && tsc -p viewer && tsc -p bots && tsc -p scripts",
    "arena": "node --no-node-snapshot --import tsx cli/src/index.ts",
    "playground": "pnpm --filter @arena/viewer dev",
    "server": "node --no-node-snapshot --import tsx cli/src/index.ts server",
    "lint": "eslint .",
    "readme": "node --import tsx scripts/readme.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "isolated-vm",
      "esbuild"
    ]
  }
}
